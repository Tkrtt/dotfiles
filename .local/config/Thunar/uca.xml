<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1613914055840245-1</unique-id>
	<command>sh -c &quot;cd %F; ${XDG_CONFIG_HOME}/userscripts/launch-apps.sh terminal&quot;</command>
	<description>Open Terminal Emulator from current directory</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>vscodium</icon>
	<name>Open VSCodium here</name>
	<submenu></submenu>
	<unique-id>1710947761669544-1</unique-id>
	<command>vscodium %f</command>
	<description>Open VSCodium Here</description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
	<text-files/>
</action>
<action>
	<icon>openbox</icon>
	<name>Restart Openbox UI</name>
	<submenu></submenu>
	<unique-id>1730028268021812-1</unique-id>
	<command>~/.local/config/openbox/joyful-desktop/toggle-mode.sh apply</command>
	<description>Use only on Xfdesktop!</description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
</action>
</actions>
